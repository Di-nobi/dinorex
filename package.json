{
  "name": "dinorex",
  "version": "1.0.6",
  "description": "AI-powered API documentation generator — one command, full docs.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "dinorex": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/public dist/public",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "api",
    "swagger",
    "postman",
    "openapi",
    "documentation",
    "cli",
    "ai"
  ],
  "author": "Dinorex",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "glob": "^10.3.10",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src/public"
  ]
}
